// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  createdAt        DateTime   @default(now())
  subscriptionTier String     @default("free")

  documents        Document[]
  questions        Question[]
}

model Document {
  id               String          @id @default(uuid())
  title            String?
  originalFilename String?
  mimeType         String?
  filePath         String          // path to file on disk or cloud
  content          String?         // extracted text content from PDF
  status           DocumentStatus  @default(PENDING)
  summary          String?         // optional generated summary
  createdAt        DateTime        @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  chunks    DocumentChunk[]
  questions Question[]
}

model DocumentChunk {
  id         String   @id @default(uuid())
  index      Int      // order of the chunk in the document
  text       String
  embedding  Json?    // later you can move to pgvector

  document   Document @relation(fields: [documentId], references: [id])
  documentId String
}

model Question {
  id         String   @id @default(uuid())
  question   String
  answer     String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  userId     String

  document   Document? @relation(fields: [documentId], references: [id])
  documentId String?
}

enum DocumentStatus {
  PENDING     // just uploaded
  PROCESSING  // extracting text / embeddings
  READY       // ready for Q&A
  FAILED      // something went wrong
}